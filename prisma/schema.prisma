// Prisma schema for NextAuth + Postgres (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model KeyValueStore {
  key       String    @id
  value     Json
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([expiresAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  source    String   @default("contact_form")
  email     String?
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model QualificationSession {
  id                 String    @id @default(cuid())
  slug               String
  industry           String
  fitScore           Int
  leadType           String
  buyingStage        String
  budgetBand         String
  urgency            String
  nextAction         String
  recommendedPackage String
  rationaleShort     String
  keySignals         Json
  redFlags           Json
  answers            Json
  context            Json
  email              String?
  consentToStore     Boolean   @default(false)
  ipHash             String?
  userAgent          String?
  status             String    @default("completed")
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([slug, createdAt])
  @@index([leadType, createdAt])
  @@index([nextAction, createdAt])
}

model Order {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  plan            String
  email           String?
  status          String
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([plan])
  @@index([status])
}

model Project {
  id               String   @id @default(cuid())
  plan             String
  status           String
  templateId       String   @default("A")
  paymentStatus    String   @default("unpaid")
  publishStatus    String   @default("draft")
  publishTarget    String?
  dnsStatus        String   @default("not_started")
  revisionsAllowed Int
  revisionsUsed    Int
  previewUrl       String
  publishedUrl     String?
  domain           String?
  draftContent     Json?
  basicSeo         Boolean
  priorityDelivery Boolean
  humanEtaDate     String
  accessToken      String   @unique
  answers          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  revisions RevisionRequest[]
  suggestions RevisionSuggestion[]
  events    ProjectEvent[]

  @@index([plan])
  @@index([status])
}

model RevisionRequest {
  id        String   @id @default(cuid())
  projectId String
  message   String
  section   String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suggestions RevisionSuggestion[]

  @@index([projectId])
  @@index([createdAt])
}

model RevisionSuggestion {
  id                 String   @id @default(cuid())
  revisionRequestId  String
  projectId          String
  section            String
  field              String
  originalValue      String?
  suggestedValue     String
  reason             String
  status             String   @default("pending")
  createdAt          DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision RevisionRequest @relation(fields: [revisionRequestId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([revisionRequestId])
  @@index([createdAt])
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}
